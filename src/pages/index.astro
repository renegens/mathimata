---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';

const adults = (await getCollection('adults')).sort((a, b) => a.data.number - b.data.number);
const games = (await getCollection('scratch-games')).sort((a, b) => a.data.number - b.data.number);
const scratchLessons = (await getCollection('scratch-lessons')).length;
const course = (await getCollection('scratch-course')).filter((e) => e.data.kind === 'lesson').length;
const firstLessons = adults.slice(0, 3);

// 5x5 LED faces for the hero micro:bit (1 = lit)
const faces = {
  happy: '0101001010000001000101110',
  wink: '0000001010000001000101110',
  heart: '0101011111111110111000100',
  surprised: '0101000000001000101000100',
};
const heart = faces.heart;
---
<Base title="Βιβλιοθήκη μαθημάτων" description="Μαθήματα ενηλίκων, παιχνίδια Scratch και κατασκευές με micro:bit." theme="home">
  <main id="main" class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="blobs" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <div class="hero-text">
        <p class="hello">Γεια σου! 👋</p>
        <h1 id="hero-title">Τι θα <span class="squiggle">μάθουμε<svg viewBox="0 0 200 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12 C 30 2, 50 2, 70 10 S 110 18, 130 9 S 175 2, 197 8" /></svg></span> σήμερα;</h1>
        <p class="lede">Μαθήματα για υπολογιστή και διαδίκτυο, παιχνίδια Scratch και φωτάκια micro:bit. Διάλεξε από πού θα ξεκινήσεις.</p>
        <p class="chips"><span>Βήμα βήμα</span><span>Στα ελληνικά</span><span>Δωρεάν αρχεία</span></p>
      </div>
      <div class="bot">
        <button class="board" id="face" type="button" aria-label="Άλλαξε το πρόσωπο του micro:bit" data-faces={JSON.stringify(faces)}>
          <span class="leds">
            {[...faces.happy].map((on) => <i class={on === '1' ? 'on' : ''}></i>)}
          </span>
          <span class="btn-a" aria-hidden="true">A</span><span class="btn-b" aria-hidden="true">B</span>
        </button>
        <p class="bot-hint">Πάτησέ με!</p>
      </div>
    </section>

    <section class="worlds" aria-label="Ενότητες">
      <a class="world w-adults" href={url('/adults/')}>
        <div class="art" aria-hidden="true">
          <div class="window">
            <div class="window-bar"><i></i><i></i><i></i><span class="addr"></span></div>
            <div class="window-body">
              <span class="line l1"></span><span class="line l2"></span><span class="line l3"></span>
              <span class="cursor"></span>
            </div>
          </div>
        </div>
        <div class="world-text">
          <span class="kind">Για ενήλικες</span>
          <h2>Μαθήματα ενηλίκων</h2>
          <p>{adults.length} ωριαία μαθήματα για υπολογιστή, διαδίκτυο και εργασία.</p>
          <ol class="peek">
            {firstLessons.map((l) => <li><b>{l.data.number}</b>{l.data.title}</li>)}
          </ol>
          <span class="go">Ξεκινώ <span class="arrow">→</span></span>
        </div>
      </a>

      <a class="world w-scratch" href={url('/scratch-games/')}>
        <div class="art" aria-hidden="true">
          <span class="block b-event">όταν πατηθεί ⚑</span>
          <span class="block b-motion">κινήσου 10 βήματα</span>
          <span class="block b-loop">για πάντα</span>
          <div class="sprites">
            {games.map((g) => <img src={url(g.data.icon)} alt="" loading="lazy" />)}
          </div>
        </div>
        <div class="world-text">
          <span class="kind">Προγραμματισμός</span>
          <h2>Παιχνίδια Scratch</h2>
          <p>Παίξε, άνοιξε τον κώδικα και φτιάξε το δικό σου.</p>
          <ul class="peek">
            <li><b>{games.length}</b>έτοιμα παιχνίδια για να ξεκινήσεις</li>
            <li><b>{scratchLessons}</b>μαθήματα με αρχείο αρχής και λύση</li>
            <li><b>{course}</b>μαθήματα για παιδιά 7–9 ετών</li>
          </ul>
          <span class="go">Παίζω και φτιάχνω <span class="arrow">→</span></span>
        </div>
      </a>

      <a class="world w-microbit" href={url('/microbit-emojis/')}>
        <div class="art" aria-hidden="true">
          <div class="mini-board">
            {[...heart].map((on) => <i class={on === '1' ? 'on' : ''}></i>)}
          </div>
        </div>
        <div class="world-text">
          <span class="kind">micro:bit · πρώτο μάθημα</span>
          <h2>Emoji στην οθόνη LED</h2>
          <p>Σχεδίασε πρόσωπα και άλλαξέ τα με τα κουμπιά A και B.</p>
          <ul class="peek">
            <li><b>5×5</b>σχεδιάζω στο πλέγμα με τα LED</li>
            <li><b>A·B</b>αλλάζω πρόσωπο με τα κουμπιά</li>
            <li><b>{'{ }'}</b>βλέπω τον κώδικα σε JavaScript</li>
          </ul>
          <span class="go">Ανάβω τα LED <span class="arrow">→</span></span>
        </div>
      </a>
    </section>

    <section class="how" aria-labelledby="how-title">
      <h2 id="how-title">Πώς δουλεύει</h2>
      <ol>
        <li><span class="n">1</span><b>Διάλεξε μάθημα</b><span>Κάθε μάθημα κρατά περίπου μία ώρα.</span></li>
        <li><span class="n">2</span><b>Ακολούθησε τα βήματα</b><span>Κατέβασε τα αρχεία και δοκίμασε μόνος ή μόνη σου.</span></li>
        <li><span class="n">3</span><b>Βάλε ✓</b><span>Τσέκαρε ό,τι κατάφερες και πήγαινε στο επόμενο.</span></li>
      </ol>
    </section>
  </main>

  <script is:inline>
    (() => {
      const board = document.getElementById('face');
      if (!board) return;
      const faces = JSON.parse(board.dataset.faces);
      const order = ['happy', 'heart', 'surprised', 'happy'];
      const leds = board.querySelectorAll('.leds i');
      let i = 0;
      const show = (name) => [...faces[name]].forEach((on, k) => leds[k].classList.toggle('on', on === '1'));
      board.addEventListener('click', () => {
        i = (i + 1) % order.length;
        show(order[i]);
        board.classList.remove('pop'); void board.offsetWidth; board.classList.add('pop');
      });
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        setInterval(() => {
          if (order[i] !== 'happy') return;
          show('wink');
          setTimeout(() => order[i] === 'happy' && show('happy'), 260);
        }, 3800);
      }
    })();
  </script>
</Base>
