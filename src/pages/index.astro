---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
const count = (await getCollection('adults')).length;
---
<Base title="Βιβλιοθήκη μαθημάτων" description="Μαθήματα ενηλίκων, παιχνίδια Scratch και κατασκευές με micro:bit." theme="home">
  <main id="main">
    <div class="home-hero">
      <p class="eyebrow">ΜΑΘΑΙΝΟΥΜΕ ΒΗΜΑ ΒΗΜΑ</p>
      <h1>Βιβλιοθήκη μαθημάτων</h1>
      <p class="lede">Διάλεξε ενότητα: μαθήματα ενηλίκων, παιχνίδια Scratch ή κατασκευές με micro:bit.</p>
    </div>
    <div class="cats">
      <a class="cat cat-adults" href={url('/adults/')}>
        <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="8" width="38" height="26" rx="3"/><path d="M16 42h16M24 34v8"/><path d="M13 17h14M13 23h22M13 29h9"/></svg>
        <span class="kind">ΓΙΑ ΕΝΗΛΙΚΕΣ</span>
        <h2>Μαθήματα ενηλίκων</h2>
        <p>{count} ωριαία μαθήματα για υπολογιστή, διαδίκτυο και εργασία.</p>
        <span class="go">Άνοιγμα μαθημάτων →</span>
      </a>
      <a class="cat cat-scratch" href={url('/scratch-games/')}>
        <svg class="ico" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 20h36v14a6 6 0 0 1-6 6H12a6 6 0 0 1-6-6z"/><path d="M14 20v-5a10 10 0 0 1 20 0v5"/><circle cx="17" cy="30" r="2.5"/><circle cx="31" cy="30" r="2.5"/></svg>
        <span class="kind">ΠΡΟΓΡΑΜΜΑΤΙΣΜΟΣ</span>
        <h2>Παιχνίδια Scratch</h2>
        <p>Παιχνίδια, γραφικά και οδηγίες εκπαιδευτή.</p>
        <span class="go">Παίζω και φτιάχνω →</span>
      </a>
      <a class="cat cat-microbit" href={url('/microbit-emojis/')}>
        <svg class="ico" viewBox="0 0 48 48" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="42" height="42" rx="6" fill="none" stroke="currentColor" stroke-width="3"/>{[0,1,2,3,4].flatMap((r) => [0,1,2,3,4].map((c) => <circle cx={10 + c * 7} cy={10 + r * 7} r="2.2" opacity={[6,8,16,17,18,22,23,24].includes(r*5+c) ? 1 : .25} />))}</svg>
        <span class="kind">MICRO:BIT · ΠΡΩΤΟ ΜΑΘΗΜΑ</span>
        <h2>Emoji στην οθόνη LED</h2>
        <p>Σχεδίασε πρόσωπα και άλλαξέ τα με τα κουμπιά A και B.</p>
        <span class="go">Ανάβω τα LED →</span>
      </a>
    </div>
  </main>
</Base>
