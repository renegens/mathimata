---
import { getEntry, render } from 'astro:content';
import AdultLayout from '../../layouts/AdultLayout.astro';
import { url } from '../../lib/url';
const entry = (await getEntry('adults-guide', 'teacher-guide'))!;
const d = entry.data;
const { Content } = await render(entry);
---
<AdultLayout title={`${d.title} · Για εκπαιδευτές`} description={d.intro} teacher aside={false}>
  <nav class="tabs" aria-label="Υλικό μαθήματος">
    <a href={url('/adults/')}>Μαθήματα ενηλίκων</a>
  </nav>
  <header class="lesson-head">
    <p class="teacher-badge">Για εκπαιδευτές</p>
    <p class="eyebrow">{d.tag}</p>
    <h1>{d.title}</h1>
    <p class="goal">{d.intro}</p>
    <div class="head-actions"><button class="btn" type="button" data-print>Εκτύπωση προγράμματος</button></div>
  </header>
  <div class="prose"><Content /></div>
</AdultLayout>
